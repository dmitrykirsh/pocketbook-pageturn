    <string name="screen_title">Screen off (advanced)</string>
    <string name="audio_switch">Silent audio stream</string>
    <string name="audio_hint">Needed for use with the screen off: the system thinks music is playing and the app catches the volume change, then puts the volume back. During Reading mode the media volume is set to the middle and restored afterwards.</string>
    <string name="keep_switch">Keep screen on (dim)</string>
    <string name="keep_hint">Fallback: the screen stays on while Reading mode is on and the accessibility service catches the keys. Uses battery.</string>

