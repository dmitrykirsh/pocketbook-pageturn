    <string name="app_name">PageTurn</string>
    <string name="a11y_desc">Intercepts the volume buttons and sends page-turn commands to your PocketBook e-reader over Wi-Fi, only while Reading mode is on. It does not read the screen content.</string>
    <string name="main_subtitle">Turn pages on your PocketBook with your phone\'s volume buttons</string>

